package {
    default_applicable_licenses: [
        "gturri_axmlrpc_LICENSE",
    ],
}

license {
    name: "gturri_axmlrpc_LICENSE",
    visibility: [":__subpackages__"],
    license_kinds: [
        "SPDX-license-identifier-MIT",
    ],
    license_text: [
        "LICENSE",
    ],
}

java_library_host {
    name: "gturri_axmlrpc",
    srcs: ["src/main/**/*.java"],
    static_libs: [
        "gturri_jiso8601",
    ],
    visibility: [
        ":__subpackages__",
        "//test/dts/libs/hostside/servo",
    ],
}

